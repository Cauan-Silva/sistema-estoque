# Copie este arquivo para .env e preencha os valores.

# Banco de dados
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sistema_estoque
DB_USER=postgres
DB_PASSWORD=troque_esta_senha

# Gere com: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=troque_esta_chave

# Logs (opcional)
LOG_LEVEL=INFO
LOG_DIR=logs

# Porta da API no Docker (opcional)
API_PORT=8000

# Consulta de preços no Mercado Livre (opcional)
# Crie um aplicativo em https://developers.mercadolivre.com.br e copie os dados dele.
# Depois rode uma vez: python -m backend.precos.autorizar_mercado_livre
MERCADO_LIVRE_CLIENT_ID=
MERCADO_LIVRE_CLIENT_SECRET=
MERCADO_LIVRE_REDIRECT_URI=

# Leitura de orçamentos em PDF e imagem (opcional)
# Crie uma chave em https://console.anthropic.com. Sem ela, só XML de NF-e é lido.
# Os arquivos de orçamento são enviados à API da Anthropic para leitura.
ANTHROPIC_API_KEY=
# Modelo usado na leitura (opcional)
ANTHROPIC_MODEL=claude-sonnet-5-5
