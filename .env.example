# Copie este arquivo para .env e preencha os valores.

# Banco de dados
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sistema_estoque
DB_USER=postgres
DB_PASSWORD=troque_esta_senha

# Gere com: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=troque_esta_chave

# Logs (opcional)
LOG_LEVEL=INFO
LOG_DIR=logs

# Porta da API no Docker (opcional)
API_PORT=8000

# Consulta de preços no Mercado Livre (opcional)
# Crie um aplicativo em https://developers.mercadolivre.com.br e copie os dados dele.
# Depois rode uma vez: python -m backend.precos.autorizar_mercado_livre
MERCADO_LIVRE_CLIENT_ID=
MERCADO_LIVRE_CLIENT_SECRET=
MERCADO_LIVRE_REDIRECT_URI=https://httpbin.org/get

# Leitura de orçamentos em PDF e imagem (opcional). Sem nenhuma das duas, só XML de NF-e é lido.
#
# Opção 1, gratuita: IA no próprio PC com Ollama (https://ollama.com).
# Instale, rode "ollama pull qwen2.5vl:7b" e preencha:
#   OLLAMA_URL=http://localhost:11434               (API rodando direto no PC)
#   OLLAMA_URL=http://host.docker.internal:11434    (API rodando no Docker)
OLLAMA_URL=
OLLAMA_MODEL=qwen2.5vl:7b
#
# Opção 2, paga por uso: API da Anthropic (https://console.anthropic.com).
# Os arquivos são enviados à Anthropic para leitura.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
#
# Com as duas configuradas, escolha qual usar: ollama ou anthropic (padrão: ollama)
LEITURA_ORCAMENTOS=
